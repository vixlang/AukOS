+#ifdef __AUKOS__
+static void aukos_prepare_atomic_output(void)
+{
+    const char *outname = get_filename(FN_OUTFILE);
+    char *tempname;
+    int fd;
+
+    if (!outname || !(operating_mode & (OP_NORMAL | OP_PREPROCESS)))
+        return;
+
+    tempname = nasm_strcat(outname, AUKOS_TEMP_SUFFIX);
+    fd = mkstemp(tempname);
+    if (fd < 0)
+        nasm_fatalf(ERR_PERROR,
+                    "unable to create temporary output for `%s'", outname);
+
+    aukos_final_outfile = (char *)outname;
+    _filenames[FN_OUTFILE] = tempname;
+    aukos_output_fd = fd;
+}
+
+static FILE *aukos_open_primary_output(enum file_flags flags)
+{
+    FILE *file;
+    int fd = aukos_output_fd;
+
+    if (fd < 0)
+        return nasm_open_write(get_filename(FN_OUTFILE), flags);
+
+    aukos_output_fd = -1;
+    file = fdopen(fd, (flags & NF_TEXT) ? "wt" : "wb");
+    if (!file)
+        close(fd);
+    return file;
+}
+
+static void aukos_finish_atomic_output(bool error)
+{
+    const char *tempname = get_filename(FN_OUTFILE);
+    int saved_errno = 0;
+    bool failed = error;
+
+    if (ofile) {
+        if (!failed && (fflush(ofile) || ferror(ofile))) {
+            saved_errno = errno;
+            failed = true;
+        }
+        if (!failed && fsync(fileno(ofile))) {
+            saved_errno = errno;
+            failed = true;
+        }
+        if (fclose(ofile) && !failed) {
+            saved_errno = errno;
+            failed = true;
+        }
+        ofile = NULL;
+    } else if (aukos_output_fd >= 0) {
+        if (close(aukos_output_fd) && !failed) {
+            saved_errno = errno;
+            failed = true;
+        }
+        aukos_output_fd = -1;
+    }
+
+    if (!failed && rename(tempname, aukos_final_outfile)) {
+        saved_errno = errno;
+        failed = true;
+    }
+    if (failed)
+        nasm_remove(tempname);
+
+    if (!error && failed) {
+        errno = saved_errno;
+        nasm_nonfatalf(ERR_PERROR,
+                       "unable to commit output file `%s'",
+                       aukos_final_outfile);
+    }
+
+    nasm_free(aukos_final_outfile);
+    aukos_final_outfile = NULL;
+}
+#endif
+
 void close_output(bool error)
 {
+#ifdef __AUKOS__
+    if (aukos_final_outfile) {
+        aukos_finish_atomic_output(error);
+        return;
+    }
+#endif
     if (!ofile)
         return;
 
