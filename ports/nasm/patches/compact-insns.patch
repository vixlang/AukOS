+void nasm_decode_itemplate(struct itemplate *result, enum opcode opcode,
+                           unsigned int index)
+{
+    const struct itemplate_list *list = &nasm_instructions[opcode];
+    const struct compact_itemplate *compact =
+        &nasm_compact_templates[list->first + index];
+
+    result->opcode = opcode;
+    result->operands = compact->operands;
+    for (unsigned int operand = 0; operand < MAX_OPERANDS; operand++) {
+        result->opd[operand] =
+            nasm_compact_operands[compact->operands_index][operand];
+        result->deco[operand] =
+            nasm_compact_decorators[compact->decorators_index][operand];
+    }
+    result->code = nasm_bytecodes + compact->code_offset;
+    result->iflag_idx = compact->iflag_idx;
+    result->xdaline = compact->xdaline;
+}
