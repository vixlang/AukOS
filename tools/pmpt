#!/usr/bin/env bash
# pmpt — AukOS Port Make & Package Tool
# Usage: pmpt new <port-name> [upstream-source-dir]
#        pmpt list
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PORTS_DIR="$ROOT/ports"
COMMON_MK="$PORTS_DIR/pmpt.mk"

cmd_help() {
    cat <<EOF
pmpt — AukOS Port Make & Package Tool

USAGE:
    pmpt new <name> [upstream-dir]    Create a new port skeleton
    pmpt list                          List existing ports
    pmpt help                          Show this help

EXAMPLES:
    pmpt new curl user/curl
    pmpt new myapp /path/to/source
EOF
}

cmd_list() {
    echo "Existing ports:"
    for d in "$PORTS_DIR"/*/; do
        name="$(basename "$d")"
        if [ -f "$d/Makefile" ]; then
            desc="$(head -5 "$d/Makefile" | grep '^# Port:' | sed 's/^# Port: *//')"
            [ -n "$desc" ] && echo "  $name  — $desc" || echo "  $name"
        fi
    done
}

cmd_new() {
    local name="$1"
    local upstream="${2:-user/$name}"
    local port_dir="$PORTS_DIR/$name"

    if [ -d "$port_dir" ]; then
        echo "error: port '$name' already exists at $port_dir" >&2
        exit 1
    fi

    mkdir -p "$port_dir/config" "$port_dir/patches" "$port_dir/tests"

    cat > "$port_dir/Makefile" <<MAKEFILE
# Port: $name — AukOS port
ROOT := $ROOT
PORT := \$(ROOT)/ports/$name
SOURCE := \$(ROOT)/$upstream
HOST_BUILD := \$(ROOT)/build/${name}-host
AUKOS_BUILD := \$(ROOT)/build/${name}-aukos
AUKOS_BIN := \$(AUKOS_BUILD)/${name}.elf

include \$(PORT)/sources.mk
include \$(ROOT)/ports/pmpt.mk

\$(AUKOS_BIN): \$(AUKOS_OBJECTS) \$(PORT_LIBC_OBJS) \$(ROOT)/user/linker.ld
	\$(PORT_LD) -nostdlib -static --gc-sections -T \$(ROOT)/user/linker.ld \
		-o \$@ \$(AUKOS_OBJECTS) \$(PORT_LIBC_OBJS)

.PHONY: aukos clean
aukos: \$(AUKOS_BIN)
clean:
	rm -rf \$(AUKOS_BUILD)

MAKEFILE

    cat > "$port_dir/config/config.h" <<CONFIG
#ifndef AUKOS_${name^^}_CONFIG_H
#define AUKOS_${name^^}_CONFIG_H

/* AukOS platform configuration for $name */
#define HAVE_CONFIG_H 1
#define __AUKOS__ 1

/* Headers */
#define HAVE_STDARG_H 1
#define HAVE_STDDEF_H 1
#define HAVE_STDINT_H 1
#define HAVE_STDLIB_H 1
#define HAVE_STRING_H 1
#define HAVE_UNISTD_H 1
#define HAVE_FCNTL_H 1
#define HAVE_SYS_TYPES_H 1
#define HAVE_SYS_STAT_H 1
#define HAVE_SYS_SOCKET_H 1
#define HAVE_NETDB_H 1
#define HAVE_NETINET_IN_H 1
#define HAVE_ARPA_INET_H 1

/* Compiler features */
#define HAVE_VARIADIC_MACROS 1
#define HAVE___BUILTIN_EXPECT 1
#define HAVE___BUILTIN_UNREACHABLE 1

/* Types */
#define SIZEOF_INT 4
#define SIZEOF_LONG 8
#define SIZEOF_SIZE_T 8
#define SIZEOF_VOIDP 8
#define WORDS_LITTLEENDIAN 1

#endif
CONFIG

    cat > "$port_dir/sources.mk" <<SOURCES
# $name — source files for AukOS port
# List of .c files relative to \$(SOURCE)
SOURCES :=

\$(eval \$(call port_objects,\$(SOURCES)))
SOURCES

    cat > "$port_dir/README.md" <<README
# $name — AukOS Port

**Status:** Skeleton generated by \`pmpt\`.

## Dependencies
- Upstream source at \`$upstream\`

## Build
\`\`\`
make -C $port_dir aukos
\`\`\`

or from the AukOS root:
\`\`\`
make ${name}-aukos-port
\`\`\`
README

    echo "Created port '$name':"
    echo "  $port_dir/Makefile"
    echo "  $port_dir/config/config.h"
    echo "  $port_dir/sources.mk"
    echo "  $port_dir/patches/"
    echo "  $port_dir/tests/"
    echo ""
    echo "Next steps:"
    echo "  1. Place upstream source at $ROOT/$upstream"
    echo "  2. Edit $port_dir/sources.mk to list source files"
    echo "  3. Edit $port_dir/config/config.h for feature flags"
    echo "  4. Build with: make $name-aukos-port"
}

case "${1:-help}" in
    new)    shift; cmd_new "$@" ;;
    list)   cmd_list ;;
    help|--help|-h) cmd_help ;;
    *)      echo "Unknown command: $1"; cmd_help; exit 1 ;;
esac
