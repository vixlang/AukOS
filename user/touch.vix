extern "C"
{
    fn printf(format: string, ...): i32
    fn aukos_vix_open(path: string, flags: i32, mode: i32): i32
    fn aukos_vix_close(fd: i32): i32
}

fn touch_help()
{
    printf("usage: touch [--] FILE...\n")
    printf("Create missing files without truncating existing files.\n")
}

fn main(argc: i32, argv: &string, envp: &string): i32
{
    if (argc == 2 and (argv[1] == "-h" or argv[1] == "--help"))
    {
        touch_help()
        return 0
    }
    if (argc < 2)
    {
        touch_help()
        return 2
    }

    let mut index = 1
    let mut paths = 0
    let mut failed = 0
    let mut options_done = 0
    while (index < argc)
    {
        let path = argv[index]
        if (options_done == 0 and path == "--") { options_done = 1 }
        elif (options_done == 0 and path.length > 0 and path[0] == '-')
        {
            printf("touch: unsupported option: %s\n", path)
            return 2
        }
        else
        {
            paths += 1
            let fd = aukos_vix_open(path, 65, 438)
            if (fd < 0)
            {
                printf("touch: cannot touch %s\n", path)
                failed = 1
            }
            elif (aukos_vix_close(fd) != 0)
            {
                printf("touch: cannot close %s\n", path)
                failed = 1
            }
        }
        index += 1
    }
    if (paths == 0)
    {
        touch_help()
        return 2
    }
    return failed
}
