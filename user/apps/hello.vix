extern "C"
{
    fn aukos_vix_write(text: string, length: usize): i64
    fn aukos_vix_streq(left: string, right: string): i32
}
fn add(a:i32,b:i32): i32
{
    return a+b
}

fn main(argc: i32, argv: &string, envp: &string): i32
{
    for(i in 1 .. 10)
    {
        aukos_vix_write("Hello\n",6)
    }
    let a = 10
    let b = 20
    let c = add(a,b)
    if(c == 30)
    {
        aukos_vix_write("c is 30\n",8)
    }
    if (argc != 2 or aukos_vix_streq(argv[1], "--vix-smoke") == 0)
    {
        return 2
    }
    let mut found_path = 0
    let mut index = 0
    while (index < 64 and envp[index] != nil)
    {
        if (aukos_vix_streq(envp[index], "PATH=/bin") == 1)
        {
            found_path = 1
        }
        index += 1
    }
    if (found_path == 0) { return 3 }
    if (aukos_vix_write("[vix_hello] PASS\n", 17) != 17) { return 4 }
    return 0
}
